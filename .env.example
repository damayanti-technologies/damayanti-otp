# ========================================================
# DAMAYANTI OTP - ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and configure values before starting
# ========================================================

# SERVER ENVIRONMENT
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
SERVER_BASE_URL=http://localhost:4000

# CORS SETTINGS (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,https://arrout.damayanticrest.online

# DATABASE (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# SECURITY & AUTHENTICATION SECRETS
# Generate cryptographically secure 64-char hex strings in production: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_min_32_chars
DEVICE_HMAC_SECRET=replace_with_device_signing_hmac_secret_min_32_chars
SESSION_SECRET=replace_with_session_cookie_secret_min_32_chars

# OTP ENGINE SETTINGS
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# COMPLIANCE & SMS GATEWAY MODE
# Options:
#   - DEVELOPMENT_MOCK (Simulates SMS dispatch without sending actual SMS)
#   - DEVELOPMENT_RESTRICTED (Only transmits to explicitly listed WHITELISTED_TEST_NUMBERS)
#   - PRODUCTION_DLT (Requires verified TRAI/DLT registration headers & BSNL configuration)
COMPLIANCE_MODE=DEVELOPMENT_MOCK
WHITELISTED_TEST_NUMBERS=+919876543210,+919999999999

# ANDROID GATEWAY BEAT INTERVAL
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60
DEVICE_POLL_TIMEOUT_MS=25000
